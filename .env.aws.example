# Copy to .env.aws on each private app EC2 instance, then set chmod 600.
# Never commit .env.aws or put long-lived AWS access keys here.
AWS_REGION=

# Private PostgreSQL endpoint (DB EC2 private DNS or RDS endpoint)
DATABASE_HOST=
DATABASE_PORT=5432
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Set to the public origin used by the browser, such as the CloudFront URL.
FRONTEND_ORIGINS=

# Set unique values before the first production database start.
SECRET_KEY=
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_FULL_NAME=ContinuityOS Administrator
BOOTSTRAP_ADMIN_PASSWORD=

# Private S3 bucket for uploaded risk attachments
ATTACHMENTS_BUCKET=
MAX_ATTACHMENT_BYTES=10485760
